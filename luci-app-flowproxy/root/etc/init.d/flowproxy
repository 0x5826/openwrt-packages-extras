#!/bin/sh /etc/rc.common
# FlowProxy - Traffic Diversion Service (OpenWrt 21 Compatibility)

START=99
STOP=10
USE_PROCD=1

. /usr/share/flowproxy/common.sh

_stop_unlocked() {
	local mode="$1"
	log_msg info "Stopping FlowProxy..."
	# 强制先移除标记，防止状态误报及旧守护进程继续动作
	rm -f "$STATE_FILE" "$DEGRADED_FILE" "$GEN_FILE"
	delete_route
	delete_rules
	if [ "$mode" != "preserve_dns" ]; then
		cleanup_dns
	fi
	rm -f "$IPTABLES_RULES"
	log_msg info "FlowProxy service stopped"
}

_register_watchdog_instance() {
	local gen="$1"
	local monitor_enabled=$(uci -q get "$UCI_CONFIG.global.monitor_enabled" || echo 0)
	if [ "$monitor_enabled" = "1" ]; then
		procd_open_instance "watchdog"
		procd_set_param command /usr/share/flowproxy/watchdog.sh "$gen"
		procd_set_param respawn 3600 5 3
		procd_close_instance
	fi
}

_start_unlocked() {
	local enabled=$(uci -q get "$UCI_CONFIG.global.enabled")

	if [ "${enabled:-0}" != "1" ]; then
		log_msg info "FlowProxy is disabled, ensuring service is stopped"
		_stop_unlocked
		return 0
	fi

	log_msg info "Starting FlowProxy..."

	check_env || { cleanup_dns; return 1; }
	check_config || { cleanup_dns; return 1; }
	apply_rules || { cleanup_dns; return 1; }
	add_route || { delete_rules; cleanup_dns; return 1; }
	setup_dns || { delete_route "quiet"; delete_rules; cleanup_dns; return 1; }

	rm -f "$DEGRADED_FILE"
	touch "$STATE_FILE"

	local gen="$(date +%s)-$$"
	echo "$gen" > "$GEN_FILE"

	_register_watchdog_instance "$gen"

	log_msg info "FlowProxy service started successfully"
	return 0
}

start_service() {
	acquire_lock || return 1
	_start_unlocked
	local ret=$?
	release_lock
	return $ret
}

stop_service() {
	acquire_lock || return 1
	if [ "${FLOWPROXY_PRESERVE_DNS:-0}" = "1" ]; then
		_stop_unlocked "preserve_dns"
	else
		_stop_unlocked
	fi
	local ret=$?
	release_lock
	return $ret
}

restart() {
	trap '' TERM
	FLOWPROXY_PRESERVE_DNS=1
	export FLOWPROXY_PRESERVE_DNS
	stop "$@"
	FLOWPROXY_PRESERVE_DNS=0
	start "$@"
}

reload_service() {
	acquire_lock || return 1
	local enabled=$(uci -q get "$UCI_CONFIG.global.enabled")
	local monitor_enabled=$(uci -q get "$UCI_CONFIG.global.monitor_enabled" || echo 0)

	if [ "${enabled:-0}" = "1" ] && [ "$monitor_enabled" = "1" ] && [ -f "$DEGRADED_FILE" ] && [ -f "$STATE_FILE" ]; then
		if check_env && check_config; then
			log_msg info "Reload triggered while in hot-degraded mode; preserving direct fallback and refreshing rule cache"
			local conf_level=$(uci -q get "$UCI_CONFIG.global.log_level"); conf_level="${conf_level:-info}"
			local rules_dir="$(dirname "$IPTABLES_RULES")"
			mkdir -p "$rules_dir"
			chmod 700 "$rules_dir"
			if [ -x "$GENERATE_SCRIPT" ]; then
				FLOWPROXY_LOG_LEVEL="$conf_level" "$GENERATE_SCRIPT" >/dev/null 2>&1 || rm -f "$IPTABLES_RULES"
			else
				rm -f "$IPTABLES_RULES"
			fi
			delete_route "quiet"
			delete_rules
			restore_dnsmasq_from_backup

			local gen="$(date +%s)-$$"
			echo "$gen" > "$GEN_FILE"
			_register_watchdog_instance "$gen"
			release_lock
			return 0
		fi
	fi

	_stop_unlocked "preserve_dns"
	_start_unlocked
	local ret=$?
	release_lock
	return $ret
}

service_triggers() {
	# 监听自身配置改动
	procd_add_reload_trigger "$UCI_CONFIG"
	# 监听防火墙重载事件，防止规则被 fw3 清空后无法自动恢复
	procd_add_reload_trigger "firewall"
}

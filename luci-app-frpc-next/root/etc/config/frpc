config frpc 'main'
	option enabled '0'
	option server_addr '127.0.0.1'
	option server_port '7000'
	option token ''
	option webServer_addr '127.0.0.1'
	option webServer_port '7400'
	option webServer_user 'admin'
	option webServer_pwd 'admin'
	option log_file '/var/log/frpc.log'
	option log_level 'info'
	option log_max_days '3'


msgstr "服务状态"

msgid "Status"
msgstr "状态"

msgid "Version"
msgstr "版本号"

msgid "Connected"
msgstr "已连接"

msgid "Connecting"
msgstr "正在连接"

msgid "Disconnected"
msgstr "已断开"

msgid "Installation Key Not Configured"
msgstr "安装密钥未配置"

msgid "Please configure a Setup Key in the Settings page to register this device."
msgstr "请在设置页面配置安装密钥以注册此设备。"

msgid "Loading..."
msgstr "正在加载..."

msgid "NetBird is not connected. Please ensure you have configured a valid Setup Key in the Settings page and the service is enabled."
msgstr "NetBird 未连接。请确保已在设置页面配置了有效的安装密钥并启用了服务。"


msgstr "未知"

msgid "NetBird Log"
msgstr "NetBird 运行日志"

msgid "Showing the last 100 lines of NetBird service logs."
msgstr "显示 NetBird 服务最后 100 行日志。"

msgid "Loading logs..."
msgstr "正在加载日志..."

msgid "No logs available."
msgstr "暂无可用日志。"

msgid "NetBird Settings"
msgstr "NetBird 设置"

msgid "Configure advanced NetBird settings."
msgstr "配置 NetBird 高级选项。"

msgid "Global Settings"
msgstr "全局设置"

msgid "Enabled"
msgstr "启用"

msgid "Enable the NetBird service."
msgstr "启用 NetBird 服务。"

msgid "A Setup Key is required to enable the service for the first time."
msgstr "首次启用服务必须填写安装密钥。"

msgid "Setup Key"
msgstr "安装密钥"

msgid "Setup key for automatic registration."
msgstr "用于自动注册的安装密钥。"

msgid "Management URL"
msgstr "管理服务器地址"

msgid "Custom management server URL (leave blank for official)."
msgstr "自定义管理服务器 URL（官方地址请留空）。"

msgid "Admin Panel URL"
msgstr "管理面板 URL"

msgid "Quick link to your NetBird admin console."
msgstr "快速访问 NetBird 管理控制台的链接。"

msgid "WireGuard Port"
msgstr "WireGuard 端口"

msgid "The UDP port used for WireGuard P2P connections."
msgstr "用于 WireGuard P2P 连接的 UDP 端口。"

msgid "Open WAN Port"
msgstr "开放 WAN 口访问"

msgid "Automatically open the specified UDP port on the WAN interface for P2P connection."
msgstr "自动在防火墙 WAN 口开放上述 UDP 端口，以优化 P2P 连接。"

msgid "Cleanup Config"
msgstr "清理生成的配置"

msgid "Automatically delete the generated network interface and firewall settings when the service is stopped."
msgstr "当停止服务时，自动删除生成的网络接口配置和防火墙设置。"

msgid "Auto Route"
msgstr "自动配置路由"

msgid "Automatically configure high-priority routing rules to bypass PBR conflicts."
msgstr "自动配置高优先级策略路由规则，解决与代理插件的冲突。"

msgid "Static Subnets"
msgstr "静态子网"

msgid "Specify subnets (e.g., 192.168.0.0/24) to automatically route through NetBird."
msgstr "指定需要通过 NetBird 访问的子网段（例如 192.168.0.0/24）。"

msgid "Log Level"
msgstr "日志等级"

msgid "Control the verbosity of the NetBird service logs."
msgstr "控制 NetBird 服务日志的详细程度。"

msgid "Debug"
msgstr "调试"

msgid "Info"
msgstr "信息"

msgid "Warn (Recommended)"
msgstr "警告 (推荐)"

msgid "Error"
msgstr "错误"

msgid "Exit Node"
msgstr "出口节点"

msgid "Allow this device to act as an exit node."
msgstr "允许此设备作为出口节点。"

msgid "NetBird is a zero-configuration private network platform based on WireGuard. Easily build a secure overlay mesh network among your multiple dispersed nodes."
msgstr "NetBird 是基于 WireGuard 的零配置私有网络管理平台。支持一键快速连接，自动构建网格化的加密 P2P 组网信道，轻松打通异地多端网络互联。"

msgid "Configure your NetBird daemon connection variables. Fill in your Setup Key or bind to your custom Self-Hosted coordination management URL to register the router."
msgstr "配置 NetBird 守护进程连接变量。在此填入 Setup Key 快速激活绑定，或配置自定义 Self-Hosted 协调服务器与管理控制台 URL。"

msgid "Inspect and stream the local NetBird daemon service logs. Synchronized topology updates, WireGuard link configurations, and peer events are shown below."
msgstr "实时查看和流式导出 NetBird 本地守护进程运行日志。包括与信号服务器握手状态、节点拓扑实时同步及加密信道更新日志。"

msgid "Masquerade"
msgstr "IP 伪装 (SNAT)"

msgid "Enable Source NAT (masquerade) on the NetBird interface. Useful if remote subnet routing requires NAT or is not aware of local LAN routes."
msgstr "在 NetBird 接口上启用源地址转换 (SNAT/Masquerade)。若远端节点无法学习当前本地局域网路由，或需要以接口 IP 身份进行访问，则建议开启。"

msgid "Networks"
msgstr "网络"

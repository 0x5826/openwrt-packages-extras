{
	"luci-app-netbird": {
		"description": "Grant LuCI access to NetBird RPC methods",
		"read": {
			"ubus": {
				"luci.netbird": [ "get_status", "get_logs" ]
			},
			"uci": [ "netbird" ]
		},
		"write": {
			"ubus": {
				"luci.netbird": [ "connect", "disconnect" ]
			},
			"uci": [ "netbird" ]
		}
	}
}

msgid ""
msgstr "Content-Type: text/plain; charset=UTF-8\n"

msgid "LinkBack 链路守护"
msgstr "网关切换"

msgid "Overview"
msgstr "概览"

msgid "Settings"
msgstr "设置"

msgid "Log"
msgstr "日志"

msgid "Real-time health state, priority mapping, and service control for Multi-WAN default routing metrics."
msgstr "用于 Multi-WAN 默认路由 Metric 的实时健康状态、优先级映射及服务控制。"

msgid "Real-time health state, priority mapping, and service control for Multi-WAN / Multi-Gateway failover."
msgstr "用于多 WAN / 多网关容灾切换的实时健康状态、优先级映射与服务控制。"

msgid "Configure Multi-WAN / Multi-Gateway failover service, health check parameters, and monitored targets."
msgstr "配置多 WAN / 单接口多网关故障切换服务、健康度检查参数与监控目标。"

msgid "Service Status"
msgstr "服务状态"

msgid "Current Status"
msgstr "当前状态"

msgid "Service Control"
msgstr "服务控制"

msgid "Restart"
msgstr "重启"

msgid "Start"
msgstr "启动"

msgid "Stop"
msgstr "停止"

msgid "Link Status"
msgstr "链路状态"

msgid "Link / Gateway Status"
msgstr "链路 / 网关状态"

msgid "Loading real-time link status..."
msgstr "正在加载实时链路状态..."

msgid "Running"
msgstr "运行中"

msgid "Stopped"
msgstr "已停止"

msgid "LinkBack daemon is not running or no links are configured. Please check Settings page."
msgstr "网关切换守护进程未运行或未配置任何链路。请检查设置页面。"

msgid "LinkBack daemon is not running or no targets are configured. Please check Settings page."
msgstr "网关切换守护进程未运行或未配置任何监控目标。请检查设置页面。"

msgid "Working Mode"
msgstr "工作模式"

msgid "Multi-WAN Interface Failover"
msgstr "多 WAN 接口链路容灾模式"

msgid "Single-Interface Multi-Gateway (Bypass/Main Gateway)"
msgstr "单接口多网关容灾模式 (主旁路由容灾)"

msgid "Single-Interface Multi-Gateway"
msgstr "单接口多网关模式"

msgid "Bind Interface"
msgstr "绑定网络接口"

msgid "The underlying network interface where all next-hop gateways reside (typically lan / br-lan)."
msgstr "所有下一跳网关所驻留的底层网络接口 (通常为 lan / br-lan)。"

msgid "Choose failover mode: Multi-WAN interface failover or Single-Interface multi-gateway redundancy (e.g. bypass gateway disaster recovery)."
msgstr "选择故障切换模式：多 WAN 接口物理链路容灾，或单接口下多网关主备容灾（例如主旁路由高可用切换）。"

msgid "Monitored Links / Gateways"
msgstr "监控链路 / 网关列表"

msgid "Add and prioritize your links or next-hop gateways. Lower priority number means higher preference (e.g., 1 = primary, 2 = backup)."
msgstr "添加并配置物理链路或下一跳网关的优先级。数值越小代表优先级越高 (例如：1 = 主选，2 = 备选)。"

msgid "Gateway Name / Alias"
msgstr "网关别名 / 名称"

msgid "Descriptive alias for this gateway (e.g. Bypass_GW, Main_Router)."
msgstr "该网关的描述性别名 (例如：旁路由主网关、光猫备用网关)。"

msgid "Gateway IP"
msgstr "网关 IP"

msgid "Next-hop IP address of this gateway (e.g. 192.168.1.254)."
msgstr "该网关的下一跳 IPv4 地址 (例如：192.168.1.254)。"

msgid "Gateway IP is required."
msgstr "网关 IP 不能为空。"

msgid "Gateway IP %s is already used by another link."
msgstr "网关 IP %s 已被其他目标使用，必须唯一。"

msgid "Gateway (Optional)"
msgstr "网关地址 (可选)"

msgid "Leave empty for automatic detection via netifd."
msgstr "留空则通过 netifd 自动获取。"

msgid "Add Monitored Target"
msgstr "添加监控目标"

msgid "Edit Monitored Target"
msgstr "编辑监控目标"

msgid "Target / Interface"
msgstr "监控目标 / 接口"

msgid "Priority"
msgstr "优先级"

msgid "Metric"
msgstr "路由跃点 (Metric)"

msgid "Gateway"
msgstr "网关地址"

msgid "Score"
msgstr "得分"

msgid "Failed"
msgstr "失败"

msgid "Executing service action: %s ..."
msgstr "正在执行服务操作: %s ..."

msgid "Service action completed successfully."
msgstr "服务操作执行成功。"

msgid "Failed to execute service action."
msgstr "服务操作执行失败。"

msgid "RPC error: %s"
msgstr "RPC 错误: %s"

msgid "Global Settings"
msgstr "全局设置"

msgid "Enable Service"
msgstr "启用服务"

msgid "Master switch to enable or disable the LinkBack failover daemon."
msgstr "启用或禁用网关切换服务的全局总开关。"

msgid "Check Interval (s)"
msgstr "检测间隔 (秒)"

msgid "Default time in seconds between each health check cycle."
msgstr "每个健康检测周期间隔时间 (秒)。"

msgid "Check Timeout (s)"
msgstr "检测超时 (秒)"

msgid "Default maximum wait time in seconds for each check probe (1s recommended to prevent blocking)."
msgstr "每个探针的最大等待超时时间 (推荐 1 秒以杜绝网络阻塞)。"

msgid "Recovery Delay"
msgstr "恢复判定延迟"

msgid "Number of consecutive successful checks required before marking link as recovered (failback anti-flap)."
msgstr "故障网关恢复健康所需连续检测成功的次数 (防抖动回切)。"

msgid "Failover Delay"
msgstr "故障判定延迟"

msgid "Number of consecutive failed checks required before marking link as faulted (failover anti-flap)."
msgstr "健康网关判定为故障所需连续检测失败的次数 (防抖动切换)。"

msgid "Monitored WAN Interfaces"
msgstr "监控网关接口"

msgid "Interface"
msgstr "网络接口"

msgid "Select a logical WAN interface from Network settings."
msgstr "从系统网络配置中选择一个逻辑 WAN 接口。"

msgid "Enabled"
msgstr "已启用"

msgid "Base Metric"
msgstr "默认跃点"

msgid "Default route metric when this link is healthy (e.g., wan=10, wan2=20)."
msgstr "当该接口健康时应用的默认路由 Metric 跃点数值 (例如：wan=10, wan2=20)。"

msgid "Ping Targets"
msgstr "Ping 检测目标"

msgid "Space-separated list of IPs to ping (e.g., 223.5.5.5 8.8.8.8)."
msgstr "通过空格分隔的 Ping 目标 IP 地址列表 (例如：223.5.5.5 8.8.8.8)。"

msgid "DNS Server"
msgstr "DNS 服务器"

msgid "DNS server IP for UDP query probe (e.g., 119.29.29.29)."
msgstr "用于 UDP 解析探测的 DNS 服务器 IP (例如：119.29.29.29)。"

msgid "DNS Domain"
msgstr "DNS 解析域名"

msgid "Domain name to resolve for DNS probe (e.g., www.baidu.com)."
msgstr "用于 DNS 探针解析的测试目标域名 (例如：www.baidu.com)。"

msgid "TCP Target"
msgstr "TCP 检测目标"

msgid "Target IP for TCP handshake probe."
msgstr "用于 TCP 三次握手探测的目标主机 IP 地址。"

msgid "TCP Port"
msgstr "TCP 检测端口"

msgid "Target port for TCP handshake probe."
msgstr "用于 TCP 探测的测试目标端口号。"

msgid "Loading logs..."
msgstr "正在加载运行日志..."

msgid "Real-time routing adjustments and health check state transitions from the linkbackd daemon."
msgstr "来自后台 linkbackd 守护程序的实时路由调整和网关健康状态转换详情。"

msgid "System Logs"
msgstr "系统日志"

msgid "No logs available."
msgstr "暂无可用运行日志。"

msgid "Check Type"
msgstr "检测类型"

msgid "Time in seconds between each health check cycle for this link (leave empty to inherit global)."
msgstr "该链路每次检测周期的时间间隔 (秒，留空继承全局)。"

msgid "Maximum wait time in seconds for each probe for this link (leave empty to inherit global)."
msgstr "该链路探针的最大等待超时时间 (秒，留空继承全局)。"

msgid "Number of consecutive successful checks required before marking this link as healthy."
msgstr "判定该链路恢复健康所需连续检测成功的次数。"

msgid "Number of consecutive failed checks required before marking this link as faulted."
msgstr "判定该链路发生故障所需连续检测失败的次数。"

msgid "Add Monitored Interface"
msgstr "添加监控接口"

msgid "Edit Monitored Interface"
msgstr "编辑监控接口"

msgid "Cannot enable service: At least 2 monitored links/gateways must be configured for failover switcher."
msgstr "无法启用服务: 容灾切换至少需要配置 2 个监控链路或网关。"

msgid "Cannot enable service: Bind interface must be configured in Multi-Gateway mode."
msgstr "无法启用服务: 单接口多网关模式下必须指定绑定的网络接口。"

msgid "Cannot enable service: Target \"%s\" has no health check configured."
msgstr "无法启用服务: 监控目标「%s」未配置健康检测策略。"

msgid "Cannot enable service: Targets \"%s\" and \"%s\" have the same priority %s."
msgstr "无法启用服务: 目标「%s」和「%s」的路由优先级均为 %s，不允许重复。"

msgid "Cannot enable service: Target \"%s\" has an invalid or missing Gateway IP."
msgstr "无法启用服务: 目标「%s」缺少有效的网关 IP。"

msgid "Cannot enable service: Targets \"%s\" and \"%s\" have the same Gateway IP %s."
msgstr "无法启用服务: 目标「%s」和「%s」具有相同的网关 IP %s，不允许重复。"

msgid "Cannot enable service: Interface \"%s\" is configured multiple times."
msgstr "无法启用服务: 接口「%s」被重复配置。"

msgid "Service has been auto-disabled because the configuration is no longer valid: "
msgstr "由于配置不再合法，服务已被自动禁用: "

msgid "Ping Probe"
msgstr "Ping 探测"

msgid "DNS Probe"
msgstr "DNS 探测"

msgid "TCP Probe"
msgstr "TCP 探测"

msgid "%s (configured)"
msgstr "%s (已配置)"

msgid "This interface has already been configured."
msgstr "该接口已被配置，请选择其他接口。"

msgid "Priority must not be empty."
msgstr "优先级不能为空。"

msgid "Priority %s conflicts with another target. Priorities must be unique."
msgstr "优先级 %s 与其他目标冲突。优先级必须是唯一的。"

msgid "Active"
msgstr "主选活跃"

msgid "Standby"
msgstr "备选待命"

msgid "Faulted"
msgstr "故障离线"

msgid "Comma-separated list of IPs to ping (e.g., 223.5.5.5,8.8.8.8)."
msgstr "逗号分隔的测试 IP 列表 (例如：223.5.5.5,8.8.8.8)。"

msgid "-- Not Configured --"
msgstr "-- 未配置 --"

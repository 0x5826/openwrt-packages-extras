msgstr "网络名称"

msgid "The VPN network name to identify this virtual network."
msgstr "用于识别此虚拟 VPN 网络的网络名称。"

msgid "Network Secret"
msgstr "网络密钥"

msgid "The secret phrase used to authorize and encrypt traffic."
msgstr "用于网络节点鉴权与流量加密的密钥密码。"

msgid "Enable DHCP IP Allocation"
msgstr "启用 DHCP 自动分配 IP"

msgid "Automatically determine and assign an IP address."
msgstr "自动获取并分配虚拟网络 IP 地址。"

msgid "Interface IPv4 Address"
msgstr "静态 IPv4 地址"

msgid "The static IPv4 address of this node. Ignored when DHCP is enabled."
msgstr "此节点的静态 IPv4 地址。启用 DHCP 时将被忽略。"

msgid "Interface IPv6 Address"
msgstr "静态 IPv6 地址"

msgid "The static IPv6 address of this node."
msgstr "此节点的静态 IPv6 地址。"


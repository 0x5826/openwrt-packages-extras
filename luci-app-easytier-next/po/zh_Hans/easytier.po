msgstr "停止服务"

msgid "Action"
msgstr "操作"

msgid "Restarting service..."
msgstr "正在重启服务..."

msgid "Connected Peer Nodes"
msgstr "已连接对等节点 (Peers)"

msgid "No connected peers found."
msgstr "未发现已连接的节点。"

msgid "Peer ID"
msgstr "节点 ID"

msgid "Virtual IP"
msgstr "虚拟 IP"

msgid "Hostname"
msgstr "主机名"

msgid "Cost"
msgstr "路由开销"

msgid "Latency"
msgstr "延迟"

msgid "Loss Rate"
msgstr "丢包率"

msgid "RX"
msgstr "接收"

msgid "TX"
msgstr "发送"


msgid "EasyTier"
msgstr "EasyTier"

msgid "EasyTier Next"
msgstr "EasyTier Next"

msgid "EasyTier is a simple, secure, decentralized mesh VPN for intranet penetration, implemented in Rust."
msgstr "EasyTier 是一款基于 Rust 实现的极简、安全、去中心化内网穿透 Mesh VPN。"

msgid "Service Status"
msgstr "服务状态"

msgid "Core Service Status"
msgstr "Core 核心服务状态"

msgid "Web Console Status"
msgstr "Web 控制台状态"

msgid "Running (Managed)"
msgstr "运行中 (受控)"

msgid "Running (Unmanaged)"
msgstr "运行中 (不受控/野进程)"

msgid "Stopped"
msgstr "未运行"


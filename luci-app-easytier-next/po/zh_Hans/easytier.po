msgstr "子网代理路由"

msgid "Subnet CIDRs to proxy and announce through this node."
msgstr "宣告并代理本端局域网子网网段。"

msgid "Web Config Server URL"
msgstr "配置服务器地址"

msgid "Remote web configuration server address."
msgstr "远程集中配置服务器地址。"

msgid "RPC Management Port"
msgstr "RPC 管理端口"

msgid "Port for local CLI and RPC management portal."
msgstr "本地管理通信端口。"

msgid "TUN Device Name"
msgstr "TUN 网卡名称"

msgid "Virtual TUN network interface name."
msgstr "虚拟 TUN 网络接口名称。"

msgid "Encryption Algorithm"
msgstr "加密算法"

msgid "None"
msgstr "无加密"

msgid "Multi-threaded Mode"
msgstr "多线程模式"

msgid "Enable multi-threaded packet processing for higher throughput."
msgstr "启用多线程数据包处理以获得更高网络吞吐。"

msgid "Custom Command Parameters"
msgstr "自定义参数"

msgid "Additional command-line parameters appended to easytier-core."
msgstr "附加传递给核心进程的其他自定义命令行参数。"

msgid "Enable Web Console Service"
msgstr "启用 Web 控制台"

msgid "Web Console Port"
msgstr "控制台端口"


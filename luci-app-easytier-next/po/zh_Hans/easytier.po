msgstr "公共对等节点发现服务器地址。"

msgid "Proxy Networks"
msgstr "子网代理"

msgid "Subnet CIDRs to proxy and announce through this node. Select from the detected local subnets below or enter custom CIDRs."
msgstr "本端节点广播的子网代理 CIDR。可从下方探测到的本地子网快捷点选，或手动输入自定义网段。"

msgid "Web Config Server URL"
msgstr "配置服务器地址"

msgid "Remote web configuration server address."
msgstr "远程集中配置服务器地址。"

msgid "RPC Management Port"
msgstr "RPC 管理端口"

msgid "Port for local CLI and RPC management portal."
msgstr "本地管理通信端口。"

msgid "TUN Device Name"
msgstr "TUN 网卡名称"


#!/bin/sh /etc/rc.common

START=90
USE_PROCD=1

NAME="easytier"
PROG="/usr/bin/easytier-core"
WEB_PROG="/usr/bin/easytier-web"
CONF_DIR="/etc/easytier"
LOG_FILE="/tmp/easytier.log"
WEB_LOG_FILE="/tmp/easytier-web.log"

setup_firewall_and_network() {
	local dev_name="$1"
	[ -z "$dev_name" ] && dev_name="easytier0"

	local changed_net=0
	local changed_fw=0

	# 1. Ensure network interface exists in UCI for broad OpenWrt compatibility
	local dev ifname
	dev=$(uci -q get network.easytier.device)
	ifname=$(uci -q get network.easytier.ifname)

	if [ -z "$dev" ] && [ -z "$ifname" ]; then
		uci -q set network.easytier=interface
		uci -q set network.easytier.proto='none'
		uci -q set network.easytier.device="$dev_name"
		uci -q set network.easytier.ifname="$dev_name"
		changed_net=1
	else
		if [ -z "$dev" ]; then
			uci -q set network.easytier.device="$dev_name"
			changed_net=1
		fi
		if [ -z "$ifname" ]; then
			uci -q set network.easytier.ifname="$dev_name"
			changed_net=1
		fi
	fi

	# 2. Zone MASQUERADE (controlled by tunnel_snat)
	local tunnel_snat target_masq="0"
	tunnel_snat=$(uci -q get easytier.settings.tunnel_snat)
	[ "$tunnel_snat" = "1" ] && target_masq="1"

	# Ensure firewall zone exists
	if ! uci -q get firewall.easytier >/dev/null; then
		uci -q set firewall.easytier=zone
		uci -q set firewall.easytier.name='easytier'
		uci -q set firewall.easytier.input='ACCEPT'
		uci -q set firewall.easytier.output='ACCEPT'
		uci -q set firewall.easytier.forward='ACCEPT'
		uci -q set firewall.easytier.masq="$target_masq"
		uci -q set firewall.easytier.mtu_fix='1'
		uci -q add_list firewall.easytier.network='easytier'
		uci -q add_list firewall.easytier.device="$dev_name"

		# Allow forwarding from LAN to EasyTier
		uci -q set firewall.easytier_fwd_lan=forwarding
		uci -q set firewall.easytier_fwd_lan.src='lan'
		uci -q set firewall.easytier_fwd_lan.dest='easytier'

		# Allow forwarding from EasyTier to LAN
		uci -q set firewall.easytier_fwd_et=forwarding
		uci -q set firewall.easytier_fwd_et.src='easytier'
		uci -q set firewall.easytier_fwd_et.dest='lan'

		# Allow forwarding from EasyTier to WAN
		uci -q set firewall.easytier_fwd_wan=forwarding
		uci -q set firewall.easytier_fwd_wan.src='easytier'
		uci -q set firewall.easytier_fwd_wan.dest='wan'
		changed_fw=1
	else
		local cur_masq
		cur_masq=$(uci -q get firewall.easytier.masq)
		if [ "$cur_masq" != "$target_masq" ]; then
			uci -q set firewall.easytier.masq="$target_masq"
			changed_fw=1
		fi

		local has_dev=0
		for d in $(uci -q get firewall.easytier.device); do
			[ "$d" = "$dev_name" ] && has_dev=1
		done
		if [ "$has_dev" = "0" ]; then
			uci -q add_list firewall.easytier.device="$dev_name"
			changed_fw=1
		fi

		local has_net=0
		for n in $(uci -q get firewall.easytier.network); do
			[ "$n" = "easytier" ] && has_net=1
		done
		if [ "$has_net" = "0" ]; then
			uci -q add_list firewall.easytier.network='easytier'
			changed_fw=1
		fi
	fi

	# 3. WAN Inbound Traffic Rule (controlled by allow_wan)
	local allow_wan
	allow_wan=$(uci -q get easytier.settings.allow_wan)

	if [ "$allow_wan" = "1" ]; then
		local custom_params wan_ports=""
		custom_params=$(uci -q get easytier.settings.custom_params)

		# Extract custom listening ports ONLY if -l/--listen/--listeners is specified
		if [ -n "$custom_params" ]; then
			local extracted_ports
			extracted_ports=$(echo "$custom_params" | grep -oE '(-l|--listeners?)[[:space:]=]+[^[:space:]]+' | grep -oE ':[0-9]{2,5}' | tr -d ':' | sort -u | tr '\n' ' ')
			set -- $extracted_ports
			extracted_ports="$*"
			[ -n "$extracted_ports" ] && wan_ports="$extracted_ports"
		fi

		# Default listener ports fallback: 11010(tcp/udp), 11011(wg/ws), 11012(quic/wss), 11013(faketcp)
		[ -z "$wan_ports" ] && wan_ports="11010 11011 11012 11013"

		local cur_rule_ports cur_rule_enabled
		cur_rule_ports=$(uci -q get firewall.easytier_wan_inbound.dest_port)
		cur_rule_enabled=$(uci -q get firewall.easytier_wan_inbound.enabled)

		if ! uci -q get firewall.easytier_wan_inbound >/dev/null || [ "$cur_rule_ports" != "$wan_ports" ] || [ "$cur_rule_enabled" != "1" ]; then
			uci -q set firewall.easytier_wan_inbound=rule
			uci -q set firewall.easytier_wan_inbound.name='Allow-EasyTier-WAN-Inbound'
			uci -q set firewall.easytier_wan_inbound.src='wan'
			uci -q set firewall.easytier_wan_inbound.proto='tcp udp'
			uci -q set firewall.easytier_wan_inbound.dest_port="$wan_ports"
			uci -q set firewall.easytier_wan_inbound.target='ACCEPT'
			uci -q set firewall.easytier_wan_inbound.enabled='1'
			changed_fw=1
		fi
	else
		if uci -q get firewall.easytier_wan_inbound >/dev/null; then
			uci -q delete firewall.easytier_wan_inbound
			changed_fw=1
		fi
	fi

	if [ "$changed_net" = "1" ]; then
		uci -q commit network
		/etc/init.d/network reload 2>/dev/null
	fi

	if [ "$changed_fw" = "1" ]; then
		uci -q commit firewall
		/etc/init.d/firewall reload 2>/dev/null
	fi

	# 4. Kernel forwarding
	sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
	sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
}

setup_dnsmasq() {
	local magic_dns tld_dns_zone
	config_get_bool magic_dns settings magic_dns 0
	config_get tld_dns_zone settings tld_dns_zone 'et.net'
	[ -z "$tld_dns_zone" ] && tld_dns_zone='et.net'

	local changed_dhcp=0

	# 1. Clean legacy server rules pointing to 100.100.100.101
	local cur_servers
	cur_servers=$(uci -q get dhcp.@dnsmasq[0].server)
	if [ -n "$cur_servers" ]; then
		local s
		for s in $cur_servers; do
			case "$s" in
				*100.100.100.101*)
					uci -q del_list dhcp.@dnsmasq[0].server="$s"
					changed_dhcp=1
					;;
			esac
		done
	fi

	# 2. Clean matching rebind domain entries
	local cur_rebinds
	cur_rebinds=$(uci -q get dhcp.@dnsmasq[0].rebind_domain)
	if [ -n "$cur_rebinds" ]; then
		local r
		for r in $cur_rebinds; do
			if [ "$r" = "$tld_dns_zone" ] || [ "$r" = "et.net" ]; then
				uci -q del_list dhcp.@dnsmasq[0].rebind_domain="$r"
				changed_dhcp=1
			fi
		done
	fi

	# 3. Add new Magic DNS forwarding and rebind whitelist if enabled
	if [ "$magic_dns" -eq 1 ]; then
		uci -q add_list dhcp.@dnsmasq[0].server="/${tld_dns_zone}/100.100.100.101"
		uci -q add_list dhcp.@dnsmasq[0].rebind_domain="${tld_dns_zone}"
		changed_dhcp=1
	fi

	if [ "$changed_dhcp" -eq 1 ]; then
		uci -q commit dhcp
		/etc/init.d/dnsmasq reload 2>/dev/null
	fi
}

cleanup_dnsmasq() {
	local tld_dns_zone
	config_get tld_dns_zone settings tld_dns_zone 'et.net'
	[ -z "$tld_dns_zone" ] && tld_dns_zone='et.net'

	local changed_dhcp=0

	local cur_servers
	cur_servers=$(uci -q get dhcp.@dnsmasq[0].server)
	if [ -n "$cur_servers" ]; then
		local s
		for s in $cur_servers; do
			case "$s" in
				*100.100.100.101*)
					uci -q del_list dhcp.@dnsmasq[0].server="$s"
					changed_dhcp=1
					;;
			esac
		done
	fi

	local cur_rebinds
	cur_rebinds=$(uci -q get dhcp.@dnsmasq[0].rebind_domain)
	if [ -n "$cur_rebinds" ]; then
		local r
		for r in $cur_rebinds; do
			if [ "$r" = "$tld_dns_zone" ] || [ "$r" = "et.net" ]; then
				uci -q del_list dhcp.@dnsmasq[0].rebind_domain="$r"
				changed_dhcp=1
			fi
		done
	fi

	if [ "$changed_dhcp" -eq 1 ]; then
		uci -q commit dhcp
		/etc/init.d/dnsmasq reload 2>/dev/null
	fi
}

start_core() {
	local enabled etcmd network_name network_secret ip_dhcp ipaddr ip6addr
	local external_node rpc_port encryption_algorithm dev_name proxy_cidrs
	local custom_params custom_config_file web_config multi_thread
	local magic_dns tld_dns_zone

	config_get_bool enabled settings enabled 0
	[ "$enabled" -eq 1 ] || return 0

	[ -x "$PROG" ] || {
		logger -t "$NAME" "Core executable $PROG not found"
		return 1
	}

	config_get etcmd settings etcmd 'etcmd'
	config_get network_name settings network_name ''
	config_get network_secret settings network_secret ''
	config_get_bool ip_dhcp settings ip_dhcp 1
	config_get ipaddr settings ipaddr ''
	config_get ip6addr settings ip6addr ''
	config_get external_node settings external_node ''
	config_get rpc_port settings rpc_port '15888'
	config_get encryption_algorithm settings encryption_algorithm ''
	config_get dev_name settings dev_name 'easytier0'
	config_get custom_config_file settings custom_config_file '/etc/easytier/config.toml'
	config_get web_config settings web_config ''
	config_get custom_params settings custom_params ''
	config_get_bool multi_thread settings multi_thread 0
	config_get_bool magic_dns settings magic_dns 0
	config_get tld_dns_zone settings tld_dns_zone 'et.net'
	[ -z "$tld_dns_zone" ] && tld_dns_zone='et.net'

	mkdir -p "$CONF_DIR"

	procd_open_instance "core"
	procd_set_param command "$PROG"

	if [ "$etcmd" = "config" ]; then
		[ -f "$custom_config_file" ] || {
			logger -t "$NAME" "Custom config file $custom_config_file not found"
			return 1
		}
		procd_append_param command -c "$custom_config_file"
	elif [ "$etcmd" = "web" ]; then
		[ -n "$web_config" ] || {
			logger -t "$NAME" "Web config URL is not configured"
			return 1
		}
		procd_append_param command -w "$web_config"
	else
		# Default command-line configuration
		[ -n "$network_name" ] && procd_append_param command --network-name "$network_name"
		[ -n "$network_secret" ] && procd_append_param command --network-secret "$network_secret"

		if [ "$ip_dhcp" -eq 1 ]; then
			procd_append_param command -d
		elif [ -n "$ipaddr" ]; then
			procd_append_param command -i "$ipaddr"
		fi

		[ -n "$ip6addr" ] && procd_append_param command --ipv6 "$ip6addr"
		[ -n "$external_node" ] && procd_append_param command -e "$external_node"
		[ -n "$rpc_port" ] && procd_append_param command --rpc-portal "0.0.0.0:${rpc_port}"
		[ -n "$encryption_algorithm" ] && procd_append_param command --encryption-algorithm "$encryption_algorithm"
		[ -n "$dev_name" ] && procd_append_param command --dev-name "$dev_name"
		[ "$multi_thread" -eq 1 ] && procd_append_param command --multi-thread

		# Always disable user-space built-in NAT and delegate forwarding to Linux kernel
		procd_append_param command --proxy-forward-by-system

		# Magic DNS
		if [ "$magic_dns" -eq 1 ]; then
			procd_append_param command --accept-dns true
			[ -n "$tld_dns_zone" ] && procd_append_param command --tld-dns-zone "$tld_dns_zone"
		fi

		# Peer nodes
		append_peer() {
			[ -n "$1" ] && procd_append_param command -p "$1"
		}
		config_list_foreach settings peeradd append_peer

		# Proxy networks / Subnet routes
		append_proxy() {
			[ -n "$1" ] && procd_append_param command -n "$1"
		}
		config_list_foreach settings proxy_networks append_proxy

		# Additional custom arguments
		if [ -n "$custom_params" ]; then
			for arg in $custom_params; do
				procd_append_param command "$arg"
			done
		fi
	fi

	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user root
	procd_close_instance

	setup_firewall_and_network "$dev_name"
	setup_dnsmasq
	logger -t "$NAME" "EasyTier core service started"
}

start_web() {
	local web_enabled web_port web_dir

	config_get_bool web_enabled settings web_enabled 0
	[ "$web_enabled" -eq 1 ] || return 0

	[ -x "$WEB_PROG" ] || {
		logger -t "$NAME" "Web console executable $WEB_PROG not found"
		return 1
	}

	config_get web_port settings web_html_port '22020'
	config_get web_dir settings web_dir '/etc/easytier'

	mkdir -p "$web_dir"

	procd_open_instance "web"
	procd_set_param command "$WEB_PROG" --db "$web_dir/easytier.db" --web-server-port "$web_port" --api-server-port "$web_port" --file-log-dir "$web_dir"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user root
	procd_close_instance

	logger -t "$NAME" "EasyTier web console started on port $web_port"
}

start_service() {
	config_load easytier
	start_core
	start_web
}

stop_service() {
	# Ensure rogue orphan processes are cleaned up
	killall -9 easytier-core 2>/dev/null
	killall -9 easytier-web 2>/dev/null
	cleanup_dnsmasq
	logger -t "$NAME" "EasyTier services stopped"
}

service_triggers() {
	procd_add_reload_trigger "easytier"
}

reload_service() {
	stop
	start
}

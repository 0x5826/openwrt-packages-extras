'use strict';

import { connect } from 'ubus';
import * as fs from 'fs';
import { cursor } from 'uci';

const DETECT_BIN = '/usr/libexec/modem-detect';
const EXECUTOR_BIN = '/usr/libexec/modem-at-executor';
const TEMPLATE_DIR = '/usr/share/modemmanager/templates';
const LOG_FILE = '/var/log/modemmanager.log';
const RUN_DIR = '/tmp/run/modemmanager';
const CACHE_DEVICES = '/tmp/run/modemmanager/devices.json';
const CACHE_STATUS = '/tmp/run/modemmanager/status.json';
const TERMINAL_LOCK = '/var/lock/modem_terminal_active.lock';

function log_message(msg) {
	let ts = fs.popen("date '+%Y-%m-%d %H:%M:%S'", 'r');
	let time_str = ts ? trim(ts.read('all')) : '';
	if (ts) ts.close();

	let line = `${time_str} ${msg}\n`;
	let f = fs.open(LOG_FILE, 'a');
	if (f) {
		f.write(line);
		f.close();
	}
}

function touch_terminal_active() {
	fs.writefile(TERMINAL_LOCK, 'active\n');
}

function safe_exec_at(port, cmd, timeout) {
	if (!port || !match(port, /^\/dev\/tty(USB|ACM)[0-9]+$/))
		return { success: false, output: 'Invalid port parameter' };

	if (!cmd)
		return { success: false, output: 'Empty command' };

	let to = (timeout && timeout > 0 && timeout <= 30) ? int(timeout) : 3;
	let clean_cmd = replace(cmd, /'/g, "'\\''");
	let p = fs.popen(`${EXECUTOR_BIN} -d '${port}' -c '${clean_cmd}' -t ${to} 2>&1`, 'r');
	if (!p)
		return { success: false, output: 'Failed to execute command helper' };

	let output = p.read('all') || '';
	p.close();

	let success = (match(output, /\bOK\b/) != null);
	return { success: success, output: trim(output) };
}

function get_effective_port(specified_port) {
	if (specified_port && match(specified_port, /^\/dev\/tty(USB|ACM)[0-9]+$/))
		return specified_port;
	let c = cursor();
	if (c) {
		c.load('modemmanager');
		let p = c.get('modemmanager', 'global', 'port');
		if (p && match(p, /^\/dev\/tty(USB|ACM)[0-9]+$/))
			return p;
	}
	let dev_content = fs.readfile(CACHE_DEVICES);
	if (dev_content) {
		let data = json(dev_content);
		if (data?.devices && length(data.devices) > 0 && data.devices[0].primary_port)
			return data.devices[0].primary_port;
	}
	return null;
}

function decode_ucs2_if_needed(text) {
	if (!text || length(text) < 4 || (length(text) % 4) != 0)
		return text;
	if (!match(text, /^[0-9A-Fa-f]+$/))
		return text;

	let codes = [];
	let has_cjk = false;
	let has_ascii_prefix = false;
	for (let i = 0; i < length(text); i += 4) {
		let hex_part = substr(text, i, 4);
		let code = int('0x' + hex_part);
		if (!code || code <= 0) return text;
		push(codes, code);
		if (substr(hex_part, 0, 2) === '00') {
			has_ascii_prefix = true;
		}
		if ((code >= 0x4E00 && code <= 0x9FFF) || (code >= 0x3000 && code <= 0x303F) || (code >= 0xFF00 && code <= 0xFFEF)) {
			has_cjk = true;
		}
	}

	// 若既无 00xx ASCII 前缀，也无 CJK 常用汉字或中文标点，判定为普通纯数字/文本，保持原样
	if (!has_cjk && !has_ascii_prefix)
		return text;

	let decoded = '';
	for (let i = 0; i < length(codes); i++) {
		decoded += chr(codes[i]);
	}
	return (decoded != '') ? decoded : text;
}

function parse_csq(csq_str) {
	let m = match(csq_str, /\+CSQ:\s*([0-9]+),([0-9]+)/);
	if (!m)
		return { raw: 99, csq: 0, rssi_dbm: null, percent: 0 };

	let raw = int(m[1]);
	let ber = int(m[2]);
	if (raw === 99 || raw > 31)
		return { raw: 99, csq: 0, rssi_dbm: null, percent: 0, ber: ber };

	let dbm = -113 + (raw * 2);
	let percent = int((raw * 100) / 31);
	return { raw: raw, csq: raw, rssi_dbm: dbm, percent: percent, ber: ber };
}

function parse_cops(cops_str) {
	let m = match(cops_str, /\+COPS:\s*[0-9]+,[0-9]+,\"([^\"]+)\"(,([0-9]+))?/);
	if (!m)
		return { operator: 'Unknown', act: 'Unknown' };

	let op = m[1];
	let act_num = (m[3] && m[3] != '') ? int(m[3]) : null;
	let act = 'Cellular';

	if (act_num === 7) act = 'LTE';
	else if (act_num === 11 || act_num === 12 || act_num === 13) act = 'NR5G';
	else if (act_num === 2) act = 'WCDMA';
	else if (act_num === 0) act = 'GSM';

	return { operator: op, act: act, act_raw: act_num };
}

function parse_serving_cell(raw_output) {
	let res = {
		rat: 'LTE',
		state: 'CAMPED',
		is_5g: false,
		mcc: '',
		mnc: '',
		cell_id: '',
		pci: '',
		tac: '',
		band: '',
		earfcn: '',
		rsrp: null,
		rsrq: null,
		sinr: null
	};

	if (!raw_output)
		return res;

	// Quectel NR5G-SA: +QENG: "servingcell","NOCONN","NR5G-SA","TDD",460,11,81A0C6063,581,81A060,633984,78,100,-104,-11,1,...
	let m_sa = match(raw_output, /\+QENG:\s*\"servingcell\",\s*\"[^\"]*\",\s*\"NR5G-SA\",\s*\"([^\"]*)\",\s*([0-9]+),\s*([0-9]+),\s*([0-9A-Fa-f]+),\s*([0-9]+),\s*([0-9A-Fa-f]+),\s*([0-9]+),\s*([0-9]+),\s*([0-9]+),\s*(-?[0-9]+),\s*(-?[0-9]+),\s*(-?[0-9]+)/);
	if (m_sa) {
		res.rat = 'NR5G-SA';
		res.is_5g = true;
		res.mcc = m_sa[2];
		res.mnc = m_sa[3];
		res.cell_id = m_sa[4];
		res.pci = m_sa[5];
		res.tac = m_sa[6];
		res.earfcn = m_sa[7];
		res.band = 'N' + m_sa[8];
		res.bandwidth = m_sa[9] + ' MHz';
		res.rsrp = int(m_sa[10]);
		res.rsrq = int(m_sa[11]);
		res.sinr = int(m_sa[12]);
		return res;
	}

	// Quectel LTE
	let m_lte = match(raw_output, /\+QENG:\s*\"servingcell\",\s*\"[^\"]*\",\s*\"LTE\",\s*\"[^\"]*\",\s*([0-9]+),\s*([0-9]+),\s*([0-9A-Fa-f]+),\s*([0-9]+),\s*([0-9A-Fa-f]+),\s*([0-9]+),\s*([0-9]+),\s*([0-9]+)/);
	if (m_lte) {
		res.rat = 'LTE';
		res.mcc = m_lte[1];
		res.mnc = m_lte[2];
		res.cell_id = m_lte[3];
		res.pci = m_lte[4];
		res.tac = m_lte[5];
		res.earfcn = m_lte[6];
		res.band = 'B' + m_lte[7];
	}

	let m_metrics = match(raw_output, /(-?[0-9]{2,3})\s*,\s*(-?[0-9]{1,3})\s*,\s*(-?[0-9]{1,3})/);
	if (m_metrics && res.rsrp == null) {
		res.rsrp = int(m_metrics[1]);
		res.rsrq = int(m_metrics[2]);
		res.sinr = int(m_metrics[3]);
	}

	return res;
}

function do_collect_status(port, net_dev) {
	let info_res = safe_exec_at(port, 'ATI', 2);
	let cpin_res = safe_exec_at(port, 'AT+CPIN?', 2);
	let csq_res = safe_exec_at(port, 'AT+CSQ', 2);
	let cops_res = safe_exec_at(port, 'AT+COPS?', 2);
	let qeng_res = safe_exec_at(port, 'AT+QENG="servingcell"', 3);
	let temp_res = safe_exec_at(port, 'AT+QTEMP', 2);

	let csq_data = parse_csq(csq_res.output);
	let cops_data = parse_cops(cops_res.output);
	let cell_data = parse_serving_cell(qeng_res.output);

	let sim_status = 'NOT_INSERTED';
	if (match(cpin_res.output, /\+CPIN:\s*READY/))
		sim_status = 'READY';
	else if (match(cpin_res.output, /\+CPIN:\s*SIM PIN/))
		sim_status = 'PIN_LOCKED';
	else if (match(cpin_res.output, /\+CPIN:\s*SIM PUK/))
		sim_status = 'PUK_LOCKED';

	let temp = null;
	let m_temp = match(temp_res.output, /\+QTEMP:\s*\"[^\"]*\",\s*\"([0-9]+)\"/);
	if (m_temp) {
		temp = int(m_temp[1]);
	} else {
		let m_temp2 = match(temp_res.output, /([0-9]{2})/);
		if (m_temp2) temp = int(m_temp2[1]);
	}

	let net_info = { connected: false, ip4: [], ip6: [], rx_bytes: 0, tx_bytes: 0 };
	let u = connect();
	if (u) {
		let net_status = u.call('network.interface', 'dump');
		if (net_status?.interface) {
			for (let i = 0; i < length(net_status.interface); i++) {
				let iface = net_status.interface[i];
				if (iface.l3_device === net_dev || iface.device === net_dev) {
					net_info.interface = iface.interface;
					net_info.connected = iface.up;
					net_info.uptime = iface.uptime;
					if (iface['ipv4-address']) {
						for (let j = 0; j < length(iface['ipv4-address']); j++) {
							let addr = iface['ipv4-address'][j];
							push(net_info.ip4, addr.address + '/' + addr.mask);
						}
					}
					if (iface['ipv6-address']) {
						for (let k = 0; k < length(iface['ipv6-address']); k++) {
							let addr = iface['ipv6-address'][k];
							push(net_info.ip6, addr.address + '/' + addr.mask);
						}
					}
					if (iface.data) {
						net_info.rx_bytes = iface.data.rx_bytes || 0;
						net_info.tx_bytes = iface.data.tx_bytes || 0;
					}
					break;
				}
			}
		}
	}

	return {
		success: true,
		port: port,
		sim_status: sim_status,
		csq: csq_data,
		operator: cops_data.operator,
		act: cell_data.is_5g ? cell_data.rat : cops_data.act,
		cell: cell_data,
		temperature: temp,
		network: net_info,
		raw_info: info_res.output,
		updated_at: fs.popen("date +%s", 'r')?.read('all')?.trim() || 0
	};
}

const methods = {
	get_devices: {
		call: function() {
			let parsed = null;
			if (fs.access(CACHE_DEVICES)) {
				let cached = fs.readfile(CACHE_DEVICES);
				if (cached) {
					try {
						parsed = json(cached);
					} catch(e) {}
				}
			}

			if (!parsed || !parsed.devices) {
				let p = fs.popen(`${DETECT_BIN} --cache 2>/dev/null`, 'r');
				if (p) {
					let content = p.read('all');
					p.close();
					try {
						parsed = json(content);
					} catch(e) {}
				}
			}

			let res = parsed || { devices: [] };

			// Inject user configured primary port from UCI
			let c = cursor();
			if (c) {
				c.load('modemmanager');
				let user_port = c.get('modemmanager', 'global', 'port');
				if (user_port && user_port != '' && res.devices && length(res.devices) > 0) {
					res.devices[0].user_configured_port = user_port;
					res.devices[0].primary_port = user_port;
				}
			}

			return res;
		}
	},

	get_templates: {
		call: function() {
			let templates = [];
			let files = fs.glob(`${TEMPLATE_DIR}/*.json`);
			if (files) {
				for (let i = 0; i < length(files); i++) {
					let file = files[i];
					let data = fs.readfile(file);
					if (data) {
						try {
							push(templates, json(data));
						} catch (e) {}
					}
				}
			}
			return { templates: templates };
		}
	},

	collect_raw_status: {
		args: { port: 'port', primary_net: 'primary_net' },
		call: function(req) {
			let port = req.args?.port || '/dev/ttyUSB2';
			let net_dev = req.args?.primary_net || 'usb0';
			return do_collect_status(port, net_dev);
		}
	},

	get_status: {
		args: { port: 'port', primary_net: 'primary_net' },
		call: function(req) {
			let port = req.args?.port || '/dev/ttyUSB2';
			let net_dev = req.args?.primary_net || 'usb0';

			// Non-blocking fast path: read decoupled background status cache directly
			if (fs.access(CACHE_STATUS)) {
				let cached = fs.readfile(CACHE_STATUS);
				if (cached) {
					try {
						let data = json(cached);
						if (data && data.success)
							return data;
					} catch(e) {}
				}
			}

			// Cold start fallback: synchronously collect once and write cache
			let status = do_collect_status(port, net_dev);
			fs.mkdir(RUN_DIR);
			fs.writefile(CACHE_STATUS, sprintf("%J\n", status));
			return status;
		}
	},

	refresh_status: {
		args: { port: 'port', primary_net: 'primary_net' },
		call: function(req) {
			let port = req.args?.port || '/dev/ttyUSB2';
			let net_dev = req.args?.primary_net || 'usb0';
			let status = do_collect_status(port, net_dev);
			fs.mkdir(RUN_DIR);
			fs.writefile(CACHE_STATUS, sprintf("%J\n", status));
			return status;
		}
	},

	send_at: {
		args: { port: 'port', cmd: 'cmd', timeout: 'timeout' },
		call: function(req) {
			let port = req.args?.port;
			let cmd = req.args?.cmd;
			let timeout = req.args?.timeout || 3;

			if (!port || !cmd)
				return { success: false, error: 'Missing port or command' };

			// Active Yielding: touch terminal lock to notify background collector to yield
			touch_terminal_active();

			log_message(`[AT] >>> ${cmd}`);
			let t0 = fs.popen("date +%s%3N 2>/dev/null || date +%s", 'r')?.read('all')?.trim() || 0;
			let res = safe_exec_at(port, cmd, timeout);
			let t1 = fs.popen("date +%s%3N 2>/dev/null || date +%s", 'r')?.read('all')?.trim() || 0;
			let duration_ms = (t1 > 0 && t0 > 0 && t1 >= t0) ? (int(t1) - int(t0)) : 0;
			log_message(`[AT] <<< ${res.output}`);

			return {
				success: res.success,
				cmd: cmd,
				output: res.output,
				duration_ms: duration_ms
			};
		}
	},

	set_mode: {
		args: {
			port: 'port',
			mode: 'mode',
			template_id: 'template_id',
			sync_network: 'sync_network',
			ifname: 'ifname',
			device_net: 'device_net'
		},
		call: function(req) {
			let port = req.args?.port;
			let mode = req.args?.mode;
			let ifname = req.args?.ifname || 'modem_wan';
			let dev_net = req.args?.device_net || 'usb0';

			if (!port || !mode)
				return { success: false, error: 'Missing parameters' };

			touch_terminal_active();

			let mode_map = {
				'qmi': '0',
				'ecm': '1',
				'mbim': '2',
				'rndis': '3',
				'ncm': '5'
			};
			let val = mode_map[mode] || '5';
			let cmd = `AT+QCFG="usbnet",${val}`;

			log_message(`[MODE] Switching mode to ${mode} (Command: ${cmd})`);
			let at_res = safe_exec_at(port, cmd, 5);

			if (req.args?.sync_network) {
				let c = cursor();
				if (c) {
					c.load('network');
					if (!c.get('network', ifname)) {
						c.set('network', ifname, 'interface');
					}

					if (mode === 'ncm') {
						c.set('network', ifname, 'proto', 'ncm');
						c.set('network', ifname, 'device', '/dev/cdc-wdm0');
					} else if (mode === 'mbim') {
						c.set('network', ifname, 'proto', 'mbim');
						c.set('network', ifname, 'device', '/dev/cdc-wdm0');
					} else if (mode === 'qmi') {
						c.set('network', ifname, 'proto', 'qmi');
						c.set('network', ifname, 'device', '/dev/cdc-wdm0');
					} else {
						c.set('network', ifname, 'proto', 'dhcp');
						c.set('network', ifname, 'device', dev_net);
					}

					c.commit('network');
					log_message(`[NETWORK] Synchronized OpenWrt network interface ${ifname} with proto ${mode}`);
				}
			}

			return {
				success: at_res.success,
				mode: mode,
				output: at_res.output
			};
		}
	},

	set_preferences: {
		args: {
			port: 'port',
			rat: 'rat',
			bands_lte: 'bands_lte',
			bands_nr5g: 'bands_nr5g'
		},
		call: function(req) {
			let port = req.args?.port;
			let rat = req.args?.rat;

			if (!port)
				return { success: false, error: 'Port required' };

			touch_terminal_active();

			let results = [];
			if (rat) {
				let cmd = `AT+QNWPREFCFG="mode_pref",${rat}`;
				log_message(`[PREF] Set network preference: ${cmd}`);
				let r = safe_exec_at(port, cmd, 3);
				push(results, r.output);
			}

			return { success: true, outputs: results };
		}
	},

	set_apn: {
		args: {
			port: 'port',
			apn: 'apn',
			pdp_type: 'pdp_type'
		},
		call: function(req) {
			let port = req.args?.port;
			let apn = req.args?.apn || 'cmiot';
			let pdp = req.args?.pdp_type || 'IPV4V6';

			if (!port)
				return { success: false, error: 'Port required' };

			touch_terminal_active();

			let cmd = `AT+CGDCONT=1,"${pdp}","${apn}"`;
			log_message(`[APN] Set APN: ${cmd}`);
			let res = safe_exec_at(port, cmd, 3);

			return { success: res.success, output: res.output };
		}
	},

	device_action: {
		args: { port: 'port', action: 'action' },
		call: function(req) {
			let port = req.args?.port;
			let action = req.args?.action;

			if (!port || !action)
				return { success: false, error: 'Missing port or action' };

			touch_terminal_active();

			let cmd = 'AT';
			if (action === 'reboot') {
				cmd = 'AT+CFUN=1,1';
			} else if (action === 'airplane_on') {
				cmd = 'AT+CFUN=4';
			} else if (action === 'airplane_off') {
				cmd = 'AT+CFUN=1';
			} else if (action === 'reset_radio') {
				safe_exec_at(port, 'AT+CFUN=0', 3);
				cmd = 'AT+CFUN=1';
			}

			log_message(`[ACTION] Executing ${action} via ${cmd}`);
			let res = safe_exec_at(port, cmd, 5);

			return { success: res.success, output: res.output };
		}
	},

	get_log: {
		call: function() {
			let content = fs.readfile(LOG_FILE) || '';
			let lines = split(content, '\n');
			let len = length(lines);
			let start = len > 100 ? len - 100 : 0;
			let out = [];
			for (let i = start; i < len; i++) {
				if (lines[i] != '') push(out, lines[i]);
			}
			return { log: join('\n', out) };
		}
	},

	clear_log: {
		call: function() {
			fs.writefile(LOG_FILE, '');
			return { success: true };
		}
	},

	get_config: {
		call: function() {
			let c = cursor();
			if (!c) return { port: '', baud: '115200' };
			c.load('modemmanager');
			let port = c.get('modemmanager', 'global', 'port') || '';
			let baud = c.get('modemmanager', 'global', 'baud') || '115200';
			return { port: port, baud: baud };
		}
	},

	save_config: {
		args: { port: 'port', baud: 'baud' },
		call: function(req) {
			let c = cursor();
			if (!c) return { success: false, error: 'Cannot open UCI cursor' };
			c.load('modemmanager');
			if (!c.get('modemmanager', 'global')) {
				c.set('modemmanager', 'global', 'global');
			}
			if (req.args?.port != null) {
				c.set('modemmanager', 'global', 'port', req.args.port);
			}
			if (req.args?.baud != null) {
				c.set('modemmanager', 'global', 'baud', req.args.baud);
			}
			c.commit('modemmanager');
			system("/etc/init.d/modemmanager restart >/dev/null 2>&1 &");
			return { success: true };
		}
	},

	get_sms_status: {
		args: { port: 'port' },
		call: function(req) {
			let c = cursor();
			let enabled = false;
			if (c) {
				c.load('modemmanager');
				let val = c.get('modemmanager', 'global', 'sms_enable');
				enabled = (val === '1' || val === 1);
			}

			if (!enabled) {
				return { enabled: false, used: 0, total: 0, reason: 'SMS module is disabled to protect IoT cards' };
			}

			let port = get_effective_port(req.args?.port);
			if (!port) {
				return { enabled: true, used: 0, total: 0, error: 'No serial port available' };
			}

			touch_terminal_active();
			let res = safe_exec_at(port, 'AT+CPMS?', 4);
			let used = 0;
			let total = 0;
			if (res.success && res.output) {
				let m = match(res.output, /\+CPMS:\s*"[^"]*",([0-9]+),([0-9]+)/);
				if (m) {
					used = int(m[1]);
					total = int(m[2]);
				}
			}

			return { enabled: true, used: used, total: total, raw: res.output };
		}
	},

	set_sms_enable: {
		args: { enabled: 'enabled', port: 'port' },
		call: function(req) {
			let is_enable = (req.args?.enabled === true || req.args?.enabled === '1' || req.args?.enabled === 1) ? '1' : '0';
			let c = cursor();
			if (!c) return { success: false, error: 'Cannot open UCI cursor' };
			c.load('modemmanager');
			if (!c.get('modemmanager', 'global')) {
				c.set('modemmanager', 'global', 'global');
			}
			c.set('modemmanager', 'global', 'sms_enable', is_enable);
			c.commit('modemmanager');

			log_message(`[SMS] SMS feature toggled to: ${is_enable}`);

			let port = get_effective_port(req.args?.port);
			if (is_enable === '1' && port) {
				touch_terminal_active();
				safe_exec_at(port, 'AT+CMGF=1;+CSCS="GSM"', 3);
			}

			return { success: true, enabled: (is_enable === '1') };
		}
	},

	get_sms_list: {
		args: { port: 'port' },
		call: function(req) {
			let c = cursor();
			let enabled = false;
			if (c) {
				c.load('modemmanager');
				let val = c.get('modemmanager', 'global', 'sms_enable');
				enabled = (val === '1' || val === 1);
			}

			if (!enabled) {
				return { enabled: false, messages: [], reason: 'SMS module is disabled' };
			}

			let port = get_effective_port(req.args?.port);
			if (!port) {
				return { enabled: true, messages: [], error: 'No serial port available' };
			}

			touch_terminal_active();
			// Ensure text mode
			safe_exec_at(port, 'AT+CMGF=1', 3);
			let res = safe_exec_at(port, 'AT+CMGL="ALL"', 10);

			let messages = [];
			if (res.success && res.output) {
				let lines = split(res.output, '\n');
				let cur_msg = null;
				let total_lines = length(lines);
				for (let i = 0; i < total_lines; i++) {
					let l = trim(lines[i]);
					if (l == '') continue;
					let m = match(l, /\+CMGL:\s*([0-9]+),"([^"]*)","([^"]*)"/);
					if (m) {
						if (cur_msg) {
							cur_msg.content = decode_ucs2_if_needed(cur_msg.content);
							push(messages, cur_msg);
						}
						let time_match = match(l, /"([0-9]{2,4}\/[0-9]{2}\/[0-9]{2}[^"]*)"/);
						let time_str = time_match ? time_match[1] : '';
						cur_msg = {
							index: int(m[1]),
							status: m[2],
							sender: m[3],
							time: time_str,
							content: ''
						};
					} else if (cur_msg) {
						if (l != 'OK' && !match(l, /^\+CMGL:/)) {
							if (cur_msg.content != '') cur_msg.content += '\n';
							cur_msg.content += l;
						}
					}
				}
				if (cur_msg) {
					cur_msg.content = decode_ucs2_if_needed(cur_msg.content);
					push(messages, cur_msg);
				}
			}

			return { enabled: true, messages: messages, count: length(messages) };
		}
	},

	send_sms: {
		args: { port: 'port', recipient: 'recipient', message: 'message' },
		call: function(req) {
			let c = cursor();
			let enabled = false;
			if (c) {
				c.load('modemmanager');
				let val = c.get('modemmanager', 'global', 'sms_enable');
				enabled = (val === '1' || val === 1);
			}

			if (!enabled) {
				return { success: false, error: 'SMS module is disabled. Please enable it before sending.' };
			}

			let port = get_effective_port(req.args?.port);
			let to = req.args?.recipient;
			let msg = req.args?.message;

			if (!port || !to || !msg) {
				return { success: false, error: 'Missing port, recipient or message body' };
			}

			let clean_to = replace(to, /[^0-9+]/g, '');
			let clean_msg = replace(msg, /'/g, "'\\''");

			touch_terminal_active();
			log_message(`[SMS] Sending SMS to ${clean_to}`);

			let p = fs.popen(`${EXECUTOR_BIN} -d '${port}' --sms-to '${clean_to}' --sms-msg '${clean_msg}' -t 15 2>&1`, 'r');
			if (!p) {
				return { success: false, error: 'Failed to launch SMS executor' };
			}
			let output = p.read('all') || '';
			p.close();

			let success = (match(output, /\+CMGS:/) != null && match(output, /\+CMS ERROR|\+CME ERROR/) == null);
			return { success: success, output: trim(output) };
		}
	},

	delete_sms: {
		args: { port: 'port', index: 'index' },
		call: function(req) {
			let c = cursor();
			let enabled = false;
			if (c) {
				c.load('modemmanager');
				let val = c.get('modemmanager', 'global', 'sms_enable');
				enabled = (val === '1' || val === 1);
			}

			if (!enabled) {
				return { success: false, error: 'SMS module is disabled' };
			}

			let port = get_effective_port(req.args?.port);
			let idx = req.args?.index;

			if (!port || idx == null) {
				return { success: false, error: 'Missing port or message index' };
			}

			touch_terminal_active();

			let cmd = '';
			if (idx === 'all' || idx === -1) {
				cmd = 'AT+CMGD=1,4';
				log_message(`[SMS] Deleting all SMS messages`);
			} else {
				cmd = `AT+CMGD=${int(idx)}`;
				log_message(`[SMS] Deleting SMS at index ${idx}`);
			}

			let res = safe_exec_at(port, cmd, 5);
			return { success: res.success, output: res.output };
		}
	}
};

return { 'luci.modem': methods };

#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG="/usr/sbin/cf-optimizer"
CONF="cf-optimizer"

start_service() {
	config_load "$CONF"
	local enabled
	config_get_bool enabled settings enabled 0
	[ "$enabled" -eq 1 ] || {
		"$PROG" clean
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /tmp/run/cf-optimizer/cf-optimizer.pid
	procd_close_instance
}

stop_service() {
	"$PROG" clean
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
